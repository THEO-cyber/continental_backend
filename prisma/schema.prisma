// Continental Auto Parts — data model. Runs on MongoDB: DATABASE_URL must be
// a mongodb+srv:// (Atlas) or mongodb:// connection string. MongoDB is
// schemaless at the storage layer, so there's no migration history here —
// `prisma db push` syncs this schema (indexes, etc.) to the cluster directly.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  username      String    @unique
  passwordHash  String    @map("password_hash")
  name          String
  role          String // 'superadmin' | 'worker'
  active        Int       @default(1)
  branchId      String?   @map("branch_id") @db.ObjectId
  branch        Branch?   @relation(fields: [branchId], references: [id])
  createdAt     String    @default("") @map("created_at")
  sales         Sale[]
  receipts      Receipt[]
  productsAdded Product[] @relation("ProductAddedBy")

  @@map("users")
}

// A physical shop location. Inventory (Product rows) belongs to exactly one
// branch; the public client site never shows branch info — it only affects
// superadmin tracking and lets workers search stock at other locations.
model Branch {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  city      String    @default("")
  active    Int       @default(1)
  createdAt String    @default("") @map("created_at")
  products  Product[]
  workers   User[]

  @@map("branches")
}

// Product.category stores this row's `key` as a plain string (not a FK) so
// existing product rows never need migrating when categories change.
// Superadmin can add new ones from Admin > Categories; the client site shows
// whichever translated name exists, falling back to the key itself.
model Category {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  key       String @unique
  nameEn    String @map("name_en")
  nameFr    String @default("") @map("name_fr")
  nameZh    String @default("") @map("name_zh")
  createdAt String @default("") @map("created_at")

  @@map("categories")
}

// A product is stocked under one or more part numbers (manufacturer part,
// alternates, cross-reference codes from other brands), each tracked as its
// own independent quantity AND price — different part numbers genuinely
// cost different amounts (OEM vs. aftermarket vs. an alternate brand). A
// worker selling this product picks which specific part number the sale
// (stock and price both) comes off of. Embedded (not a separate
// collection): part numbers have no identity or lifecycle outside their
// product, so they move and delete atomically with it.
type PartNumber {
  partNumber String @map("part_number")
  quantity   Int
  price      Int
}

model Product {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  slug        String       @unique
  partNumbers PartNumber[] @map("part_numbers")
  nameEn      String       @map("name_en")
  nameFr      String       @default("") @map("name_fr")
  nameZh      String       @default("") @map("name_zh")
  descEn      String       @default("") @map("desc_en")
  descFr      String       @default("") @map("desc_fr")
  descZh      String       @default("") @map("desc_zh")
  category    String       @default("accessories")
  brand       String       @default("")
  image       String       @default("")
  published   Int          @default(1)
  // 'approved' (live immediately — superadmin-added) | 'pending' (worker-added,
  // awaiting superadmin review) — pending items never appear to the client or
  // in the workers' sell list until approved.
  status      String       @default("approved")
  branchId    String       @map("branch_id") @db.ObjectId
  branch      Branch       @relation(fields: [branchId], references: [id])
  createdById String?      @map("created_by_id") @db.ObjectId
  createdBy   User?        @relation("ProductAddedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   String       @default("") @map("created_at")
  updatedAt   String       @default("") @map("updated_at")
  sales       Sale[]

  @@index([published])
  @@index([status])
  @@index([branchId])
  @@map("products")
}

model Sale {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  // Optional + SetNull: superadmin can hard-delete a product or worker
  // (Cloudinary + DB) even with sales history attached (that's the point of
  // the delete — see products.service.ts / users.service.ts). Without
  // SetNull, Prisma's MongoDB referential integrity emulation blocks the
  // delete outright while any Sale still points at it. toApiSale() in
  // sales.service.ts renders a null product/worker as "(deleted product)" /
  // "(deleted worker)" instead of crashing.
  productId  String?  @map("product_id") @db.ObjectId
  workerId   String?  @map("worker_id") @db.ObjectId
  // Which of the product's part numbers this sale came off of. Optional:
  // sales recorded before this feature existed have none, and toApiSale()
  // falls back gracefully for those.
  partNumber String?  @map("part_number")
  quantity   Int
  unitPrice  Int      @map("unit_price")
  total      Int
  saleDate   String   @map("sale_date")
  createdAt  String   @default("") @map("created_at")
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  worker     User?    @relation(fields: [workerId], references: [id], onDelete: SetNull)

  @@index([saleDate])
  @@index([productId])
  @@index([workerId])
  @@map("sales")
}

model Setting {
  key   String @id @map("_id")
  value String @default("")

  @@map("settings")
}

// A standalone business document (unlike Sale, which is the per-unit stock
// ledger): superadmin issues these to companies or walk-in buyers, with
// price/name snapshotted at issue time so later product edits never change
// a receipt already handed to a customer.
model Receipt {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  receiptNumber String        @unique @map("receipt_number")
  buyerType     String        @map("buyer_type") // 'company' | 'individual'
  buyerName     String        @map("buyer_name")
  buyerPhone    String        @default("") @map("buyer_phone")
  buyerAddress  String        @default("") @map("buyer_address")
  notes         String        @default("")
  subtotal      Int
  total         Int
  issuedById    String        @map("issued_by_id") @db.ObjectId
  issuedBy      User          @relation(fields: [issuedById], references: [id])
  createdAt     String        @default("") @map("created_at")
  items         ReceiptItem[]

  @@index([createdAt])
  @@map("receipts")
}

model ReceiptItem {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  receiptId   String  @map("receipt_id") @db.ObjectId
  // Cascade: deleting a receipt deletes its line items with it (unlike
  // Sale/Product, a receipt with no items isn't meaningful history worth
  // keeping around) — see ReceiptsService.remove().
  receipt     Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  productId   String? @map("product_id") @db.ObjectId
  productName String  @map("product_name")
  sku         String  @default("")
  quantity    Int
  unitPrice   Int     @map("unit_price")
  total       Int

  @@index([receiptId])
  @@map("receipt_items")
}
